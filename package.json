{
  "name": "fb-marketing-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "generate": "tsx scripts/generate-contract.ts",
    "generate:check": "tsx scripts/generate-contract.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:check && tsc && node -e \"require('node:fs').copyFileSync('openapi.yaml','dist/openapi.yaml')\"",
    "start": "node dist/src/server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@js-temporal/polyfill": "0.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "decimal.js": "10.6.0",
    "fastify": "5.12.1",
    "file-type": "22.0.2",
    "openapi-backend": "5.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}